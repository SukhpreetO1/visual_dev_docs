# ─── Server ───────────────────────────────────────────────────────────────────
PORT_API=3001
PORT_WEB=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev: postgresql://user:pass@localhost:5432/visual_dev_docs
# Production: Neon connection string (copy from Neon dashboard)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visual_dev_docs

# ─── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# ─── Security ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ─── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048

# ─── Code Execution Sandbox ───────────────────────────────────────────────────
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY_LIMIT_MB=128

# ─── Jobs / Cron ──────────────────────────────────────────────────────────────
CRON_SECRET=
JOBS_INLINE=false

# ─── Razorpay (Billing) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Alerts (optional) ────────────────────────────────────────────────────────
ALERT_WEBHOOK_URL=
